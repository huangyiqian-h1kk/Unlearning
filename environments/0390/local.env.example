# Copy to repository-root local.env, then edit paths for your ABCI checkout.
export CONREP_WORK_ROOT=/groups/gcg51557/experiments/0390_rlsd/unlearning
export CONREP_ENV=$CONREP_WORK_ROOT/envs/conrep-py311-cu124
export CONREP_PYTHON=$CONREP_WORK_ROOT/envs/bootstrap-py311/bin/python
export CONREP_MODEL_ROOT=$CONREP_WORK_ROOT/models
# The GPU job loads this toolkit before importing PyTorch/DeepSpeed.
export CONREP_CUDA_MODULE=cuda/12.4/12.4.1
export HF_HOME=$CONREP_WORK_ROOT/cache/huggingface
export PIP_CACHE_DIR=$CONREP_WORK_ROOT/cache/pip
export CONDA_PKGS_DIRS=$CONREP_WORK_ROOT/cache/conda
# Expose Git LFS installed with the bootstrap environment.
case ":$PATH:" in
  *":$CONREP_WORK_ROOT/envs/bootstrap-py311/bin:"*) ;;
  *) export PATH="$PATH:$CONREP_WORK_ROOT/envs/bootstrap-py311/bin" ;;
esac
# Set this only AFTER the shared SFT checkpoint has been selected.
# export CONREP_SFT_CHECKPOINT=$CONREP_WORK_ROOT/Unlearning/results/validated_v2/0390/qwen7b/sft/checkpoint-500
# export CONREP_FALCON_LAYERS=$CONREP_WORK_ROOT/Unlearning/results/validated_v2/0390/qwen7b/falcon-layers.json
